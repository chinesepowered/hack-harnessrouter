# Sentinel — environment variables
# Copy to .env.local for local dev, or set these in your Vercel project settings.
# NOTE: the HarnessRouter API key is NOT kept here in local dev — see README (.env.harnessrouter).

# ── HarnessRouter (required) ─────────────────────────────────────────────
# The Security Analyst agent's API key. Server-only; never exposed to the browser.
# Local dev reads it from .env.harnessrouter (the skill's key file). On Vercel, set it here.
HR_API_KEY=

# ── Signing secrets (REQUIRED in production) ─────────────────────────────
# Stable secrets so the session cookie and signed preview URLs keep validating across
# serverless invocations (each invocation is a fresh process). Generate with:
#   openssl rand -hex 24    # COOKIE_SECRET
#   openssl rand -hex 32    # PREVIEW_SIGNING_SECRET (must be 64 hex chars)
COOKIE_SECRET=
PREVIEW_SIGNING_SECRET=

# ── Durable task store (recommended on Vercel) ───────────────────────────
# Without these, task records live in memory and do NOT survive across serverless
# invocations. Provision Vercel KV / Upstash Redis and set either KV_* or UPSTASH_*:
KV_REST_API_URL=
KV_REST_API_TOKEN=
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=

# ── Optional per-task budget ceilings ────────────────────────────────────
# Thorough reports on qwen3.8-max can run 15-20 min, so the time budget is generous.
# HR_TASK_TIMEOUT_SECONDS=3600
# HR_TASK_MAX_STEP=200
# HR_TASK_MAX_COST_USD=4
